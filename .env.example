# Copy to .env.local for local development. Never commit real secrets.
# Production: add these in Netlify or Vercel project settings.

# ── Public URL, Search & Analytics ───────────────────────────
# Use the final canonical origin, with no trailing slash.
NEXT_PUBLIC_SITE_URL="https://ngdsolutions.com"
# GA4 → Admin → Data streams → your web stream → Measurement ID
# Change this to another stream ID, or set empty to disable GA and its consent banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-M840HRYWV6"
# Google Search Console → HTML tag verification → content value only
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ── Database (required for persistent production enquiries) ──
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Admin dashboard ──────────────────────────────────────────
# The default local/dashboard path is /ngd-control-8421
# Set a new long random path before production and share it only with your team.
ADMIN_PATH="/ngd-control-8421"
# Option A: one owner login
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-long-random-password"
ADMIN_NAME="Site Owner"
# Option B: team logins (takes precedence over option A)
# TEAM_MEMBERS='[{"username":"owner","password":"strong-pass","name":"Owner","role":"admin"},{"username":"member","password":"strong-pass-2","name":"Team Member","role":"member"}]'

# ── Privacy / security ───────────────────────────────────────
IP_SALT="replace-with-a-long-random-string"

# ── Optional new-enquiry alerts ──────────────────────────────
# Email (Resend)
# RESEND_API_KEY="re_xxxxxxxxxxxx"
# NOTIFY_FROM="NGD Website <alerts@your-verified-domain.com>"
# NOTIFY_EMAIL="hello@ngdsolutions.com"
# WhatsApp Cloud API
# WHATSAPP_TOKEN="EAAG..."
# WHATSAPP_PHONE_ID="123456789012345"
# ALERT_WHATSAPP_TO="919465938126"
# CallMeBot
# CALLMEBOT_PHONE="+919465938126"
# CALLMEBOT_APIKEY="123456"
# Slack / Discord / Zapier / Make / n8n
# NOTIFY_WEBHOOK="https://hooks.slack.com/services/..."

# ── Optional server-side contact overrides ───────────────────
# Normally edit site.config.json instead; it updates the whole site.
# SITE_EMAIL="hello@ngdsolutions.com"
# SITE_PHONE="+91 94659 38126"
# SITE_WHATSAPP="919465938126"
# SITE_WHATSAPP_DISPLAY="+91 94659 38126"
# Public per-environment overrides used by Next.js (rarely needed):
# NEXT_PUBLIC_SITE_EMAIL="hello@ngdsolutions.com"
# NEXT_PUBLIC_SITE_PHONE="+91 94659 38126"
