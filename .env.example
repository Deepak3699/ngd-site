# ─────────────────────────────────────────────────────────────
#  NGD site — environment variables
#  Local dev : copy this file to `.env.local`
#  Vercel    : Project → Settings → Environment Variables
#
#  Everything here is OPTIONAL except DATABASE_URL in production.
#  Start with nothing set: the site works, responses are saved to a
#  local file, the dashboard is open at /admin.
# ─────────────────────────────────────────────────────────────

# ── 1) Database (required in production) ──────────────────────
#    Neon console → your project → Connection Details → Pooled connection
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ── 2) Hiding the dashboard ──────────────────────────────────
#    Set a long, unguessable path and the dashboard moves there.
#    /admin and /admin/anything then return a plain 404 to everybody,
#    so nothing on the public site links to your dashboard any more.
#    Share this one URL with your team — it is the only way in.
# ADMIN_PATH="/ngd-control-8241"

# ── 3) Login (set at least one of the two options below) ─────
#    Without these the dashboard is OPEN: whoever has the link can read
#    every response. The dashboard shows a red warning banner until set.
#
#  (a) single owner — simplest
# ADMIN_USERNAME="admin"                  # optional; defaults to "admin"
# ADMIN_PASSWORD="change-me-please"
# ADMIN_NAME="Your Name"                  # shown in the topbar + worklog
#
#  (b) a login per team member — recommended for a team
#      role "admin"  → can delete responses
#      role "member" → can read, change status, assign, write notes
# TEAM_MEMBERS='[{"username":"aman","password":"strong-pass-1","name":"Aman","role":"admin"},{"username":"simran","password":"strong-pass-2","name":"Simran","role":"member"}]'

# ── 4) Alert me when a new enquiry arrives ───────────────────
#    All optional and independent — turn on as many as you like.
#    The dashboard → "New-enquiry alerts" panel shows what is live.
#
#  Email via Resend (free tier: 100/day, 3000/month)
# RESEND_API_KEY="re_xxxxxxxxxxxx"
# NOTIFY_FROM="NGD Website <alerts@ngdsolutions.com>"   # must be a verified sender
# NOTIFY_EMAIL="you@ngdsolutions.com"                   # where alerts go (default: site.config.json email)
#
#  WhatsApp via Meta Cloud API (official, needs a Meta business number)
# WHATSAPP_TOKEN="EAAG..."
# WHATSAPP_PHONE_ID="123456789012345"
# ALERT_WHATSAPP_TO="919999999999"
#
#  WhatsApp via CallMeBot (free, 2-minute setup: https://www.callmebot.com/blog/free-api-whatsapp-messages/)
# CALLMEBOT_PHONE="+919999999999"
# CALLMEBOT_APIKEY="123456"
#
#  Any webhook — Slack / Discord / Zapier / Make / n8n
# NOTIFY_WEBHOOK="https://hooks.slack.com/services/..."

# ── 5) Contact details override (optional) ───────────────────
#    Normally you edit `site.config.json` and run `npm run build`.
#    These variables win over that file if you want them per-environment.
# SITE_EMAIL="hello@ngdsolutions.com"
# SITE_PHONE="+91 99999 99999"
# SITE_WHATSAPP="919999999999"            # digits only, wa.me format
# SITE_WHATSAPP_DISPLAY="+91 99999 99999"

# ── 6) Privacy ───────────────────────────────────────────────
#    Salt used to hash visitor IPs before they are stored.
IP_SALT="pick-any-random-string"

# ── 7) Local dev ─────────────────────────────────────────────
PORT=3000
